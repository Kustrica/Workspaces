{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "author": "Kustrica (Telegram: @Kustrica)",
  "homepage_url": "https://t.me/Kustric",
  "version": "1.19.16",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "sessions",
    "tabHide",
    "menus",
    "contextMenus",
    "alarms"
  ],
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_icon": "icons/main1-200.png",
    "default_title": "Workspaces"
  },
  "action": {
    "default_title": "Workspaces",
    "default_icon": "icons/main1-200.png"
  },
  "icons": {
    "200": "icons/main1-200.png"
  },
  "background": {
    "scripts": [
      "i18n.js",
      "sync.js",
      "background.js"
    ]
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Q",
        "mac": "Command+Q"
      },
      "description": "__MSG_cmdOpenSidebar__"
    },
    "switch_workspace_1": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "__MSG_cmdOpenWorkspace1__"
    },
    "switch_workspace_2": {
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "Command+Shift+2"
      },
      "description": "__MSG_cmdOpenWorkspace2__"
    },
    "switch_workspace_3": {
      "suggested_key": {
        "default": "Ctrl+Shift+3",
        "mac": "Command+Shift+3"
      },
      "description": "__MSG_cmdOpenWorkspace3__"
    },
    "switch_workspace_4": {
      "suggested_key": {
        "default": "Ctrl+Shift+4",
        "mac": "Command+Shift+4"
      },
      "description": "__MSG_cmdOpenWorkspace4__"
    },
    "switch_workspace_5": {
      "suggested_key": {
        "default": "Ctrl+Shift+5",
        "mac": "Command+Shift+5"
      },
      "description": "__MSG_cmdOpenWorkspace5__"
    },
    "switch_workspace_6": {
      "suggested_key": {
        "default": "Ctrl+Shift+6",
        "mac": "Command+Shift+6"
      },
      "description": "__MSG_cmdOpenWorkspace6__"
    },
    "switch_workspace_7": {
      "suggested_key": {
        "default": "Ctrl+Shift+7",
        "mac": "Command+Shift+7"
      },
      "description": "__MSG_cmdOpenWorkspace7__"
    },
    "switch_workspace_8": {
      "suggested_key": {
        "default": "Ctrl+Shift+8",
        "mac": "Command+Shift+8"
      },
      "description": "__MSG_cmdOpenWorkspace8__"
    },
    "switch_workspace_9": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "__MSG_cmdOpenWorkspace9__"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "workspaces@kustrica.addon",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
